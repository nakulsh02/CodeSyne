    "content": "\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Modern Card</title>\n\n<style>\n*{\n    margin:0;\n        padding:0;\n            box-sizing:border-box;\n                font-family:Arial, Helvetica, sans-serif;\n                }\n\n                body{\n                    display:flex;\n                        justify-content:center;\n                            align-items:center;\n                                min-height:100vh;\n                                    background:linear-gradient(135deg,#4f46e5,#06b6d4);\n                                    }\n\n                                    .card{\n                                        width:340px;\n                                            background:rgba(255,255,255,0.15);\n                                                backdrop-filter:blur(15px);\n                                                    border:1px solid rgba(255,255,255,0.3);\n                                                        border-radius:20px;\n                                                            padding:30px;\n                                                                text-align:center;\n                                                                    color:#fff;\n                                                                        box-shadow:0 15px 35px rgba(0,0,0,.25);\n                                                                            transition:.4s;\n                                                                            }\n\n                                                                            .card:hover{\n                                                                                transform:translateY(-10px);\n                                                                                    box-shadow:0 20px 45px rgba(0,0,0,.35);\n                                                                                    }\n\n                                                                                    h1{\n                                                                                        font-size:2rem;\n                                                                                            margin-bottom:10px;\n                                                                                            }\n\n                                                                                            p{\n                                                                                                opacity:.9;\n                                                                                                    margin-bottom:25px;\n                                                                                                        line-height:1.6;\n                                                                                                        }\n\n                                                                                                        button{\n                                                                                                            background:#fff;\n                                                                                                                color:#4f46e5;\n                                                                                                                    border:none;\n                                                                                                                        padding:12px 28px;\n                                                                                                                            border-radius:50px;\n                                                                                                                                font-size:16px;\n                                                                                                                                    font-weight:bold;\n                                                                                                                                        cursor:pointer;\n                                                                                                                                            transition:.3s;\n                                                                                                                                            }\n\n                                                                                                                                            button:hover{\n                                                                                                                                                background:#4f46e5;\n                                                                                                                                                    color:#fff;\n                                                                                                                                                        transform:scale(1.05);\n                                                                                                                                                        }\n                                                                                                                                                        </style>\n\n                                                                                                                                                        </head>\n                                                                                                                                                        <body>\n\n                                                                                                                                                        <div class=\"card\">\n                                                                                                                                                            <h1>Hello, Nakul 👋</h1>\n                                                                                                                                                                <p>\n                                                                                                                                                                        Welcome to your beautiful HTML & CSS page.\n                                                                                                                                                                                This card has a modern glassmorphism design with smooth hover effects.\n                                                                                                                                                                                    </p>\n\n                                                                                                                                                                                        <button onclick=\"alert('Welcome! 🚀')\">\n                                                                                                                                                                                                Click Me\n                                                                                                                                                                                                    </button>\n                                                                                                                                                                                                    </div>\n\n                                                                                                                                                                                                    </body>\n                                                                                                                                                                                                    </html>",
