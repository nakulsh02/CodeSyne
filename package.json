{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "build": "vite build --config frontend/vite.config.ts && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node -e \"const fs=require('fs'); if (fs.existsSync('frontend/dist')) { fs.mkdirSync('dist', {recursive: true}); fs.cpSync('frontend/dist', 'dist', {recursive: true}); } fs.writeFileSync('dist/server.js', 'import \\\"./server.cjs\\\";\\n'); if (fs.existsSync('dist/server.cjs.map')) fs.cpSync('dist/server.cjs.map', 'dist/server.js.map');\"",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "start": "node dist/server.js",
    "clean": "rm -rf dist frontend/dist backend/dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.7.4",
    "motion": "^12.23.24",
    "png-to-ico": "^3.0.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tauri-apps/cli": "^1.6.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
